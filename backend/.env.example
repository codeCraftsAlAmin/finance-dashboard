# Copy to .env and adjust. Never commit the real .env.
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (32+ chars) when ENVIRONMENT=production. It also protects vault unlock tokens.
SECRET_KEY=
# Local default is SQLite. For a hosted database use a Postgres URL, for example:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DATABASE_URL=sqlite:///./data/finance.db
CORS_ORIGINS=http://localhost:3000
